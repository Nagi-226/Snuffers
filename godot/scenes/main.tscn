[ext_resource type="Script" path="res://scripts/weapons/combat_fx.gd" id="11_combat_fx"]

[node name="Main" type="Node3D"]

[node name="GreyboxArena" parent="." instance=ExtResource("1_arena")]

; 玩家：出生点 GameConfig.START_POS(90,-55)，对应 greybox Markers/start_pos；y=0.1 防初始穿插
