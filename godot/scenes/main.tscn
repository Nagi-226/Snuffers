[gd_scene load_steps=12 format=3]

; G2 驻军集成（W6 质检蜂串行）：灰盒关卡 + 代表性驻军
;   步兵×6（靠近 cover_point 分布）/ 机枪手×2（MG1/MG2 标记位）/
;   碉堡机枪×1（碉堡 muzzle_ne 口）/ 狙击手×1（sniper_perch 标记）
; G2 收尾总装（W6 串行）：玩家实例化于出生点 GameConfig.START_POS(90,-55)，
;   地面顶面 y=0，胶囊底部贴地留 0.1 余量；HUD / AudioManager 挂根。
;   骨架期占位 Camera3D / DirectionalLight3D 已移除（玩家相机 current 已就绪，
;   灰盒光照由 DayNightController 昼夜控制器接管——2026-07-30 总装，避免双重叠加）。
; Phase 0b 总装（2026-08-19 蜂后串行）：18+2 全量部署（步兵 6→14，固定编制达 18）
;   + MissionDirector（G3 任务链：解锁→呼叫→60s 坚守→登机→结算，事件狙击手×2 注入）
;   + CombatFX（§11.1 曳光/枪口火光）+ MissionEndScreen（结算/失败界面）。

[ext_resource type="PackedScene" path="res://scenes/levels/greybox_arena.tscn" id="1_arena"]
[ext_resource type="PackedScene" path="res://scenes/enemies/infantry.tscn" id="2_infantry"]
[ext_resource type="PackedScene" path="res://scenes/enemies/machine_gunner.tscn" id="3_machine_gunner"]
[ext_resource type="PackedScene" path="res://scenes/enemies/bunker_machine_gunner.tscn" id="4_bunker_mg"]
[ext_resource type="PackedScene" path="res://scenes/enemies/sniper.tscn" id="5_sniper"]
[ext_resource type="PackedScene" path="res://scenes/player/player.tscn" id="6_player"]
