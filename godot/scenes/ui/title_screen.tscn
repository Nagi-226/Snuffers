[gd_scene load_steps=3 format=3]

; 游戏开头画面（07 美术设定 §3.1 机主指令 2026-08-19）：
;   纯黑底 + EDAA 徽记居中缓显（特写 → 拉远全貌），标题与提示叠加其上。
; 徽记图样唯一基准：res://assets/branding/edaa_emblem.png（机主原创，禁止变体重绘）。

[ext_resource type="Texture2D" path="res://assets/branding/edaa_emblem.png" id="1_emblem"]
[ext_resource type="Script" path="res://scripts/ui/title_screen.gd" id="2_script"]

[node name="TitleScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("2_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 1)

[node name="Emblem" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.42
anchor_right = 0.5
anchor_bottom = 0.42
offset_left = -280.0
offset_top = -280.0
offset_right = 280.0
offset_bottom = 280.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("1_emblem")
expand_mode = 1
stretch_mode = 5

[node name="TitleLabel" type="Label" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 36.0
offset_bottom = 90.0
grow_horizontal = 2
theme_override_colors/font_color = Color(0.847, 0.851, 0.855, 1)
theme_override_font_sizes/font_size = 44
text = "熄 烛 者    S N U F F E R S"
horizontal_alignment = 1

[node name="PromptLabel" type="Label" parent="."]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -72.0
offset_bottom = -40.0
grow_horizontal = 2
grow_vertical = 0
theme_override_colors/font_color = Color(0.6, 0.62, 0.65, 1)
theme_override_font_sizes/font_size = 18
text = "—— 按任意键开始作业 ——"
horizontal_alignment = 1
vertical_alignment = 1

[node name="CreditsButton" type="Button" parent="."]
layout_mode = 1
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -160.0
offset_top = -72.0
offset_right = -24.0
offset_bottom = -40.0
grow_horizontal = 0
grow_vertical = 0
focus_mode = 0
theme_override_font_sizes/font_size = 16
text = "资产署名"

[node name="CreditsPanel" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchor_left = 0.12
anchor_top = 0.12
anchor_right = 0.88
anchor_bottom = 0.84
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="CreditsPanel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Heading" type="Label" parent="CreditsPanel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "社区武器与手臂 · 资产署名"
horizontal_alignment = 1

[node name="CreditsText" type="RichTextLabel" parent="CreditsPanel/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 16
text = "社区模型与手臂按 CC-BY 4.0 使用并改作：
https://creativecommons.org/licenses/by/4.0/
模型尺寸、贴图与配件装配已调整；原生手臂动画按动作分段。

Sig Sauer MPX — michalstk11
https://sketchfab.com/models/d6e0a8020a7b4a9a876787ec91290022

ARCTIC — White SIG516 SOPMOD（含原装 ACOG）— N-GONE
https://sketchfab.com/3d-models/arctic-white-sig-516-sopmod-a9ea47674b824665b4e3b58a28b149e8
本项目调整尺寸与贴图，将配件装配为 PEQ15、SureFire 手电与下握把，并提取 HUD 线稿。

Low-Poly SR-25 — TastyTony
https://sketchfab.com/3d-models/low-poly-sr-25-81976c51d61543a288cf135fd7485951
本项目调整尺寸与部件，装配下列 Leupold 镜体与 Harris 两脚架，并提取 HUD 线稿。

Remington Model 700 .308 Winchester Low Poly（含原装镜体）— mehmetuysun
https://sketchfab.com/3d-models/remington-model-700-308-winchester-low-poly-f55c2e95edd84b80b283e181d63e5ef6
本项目调整部件与栓动姿态，保留原装镜体，并提取 HUD 线稿。

Leupold Mk4 LRT M1 10×40mm Scope (Low-Poly) — GoldbergR
https://sketchfab.com/3d-models/leupold-mk-4-lrt-m1-1040mm-scope-low-poly-bf0e3597985940408d24669297d15509

Harris Bipod (Low-Poly) — GoldbergR
https://sketchfab.com/3d-models/harris-bipod-low-poly-daa7dd1e247e453496974a5d252396f4
镜体与两脚架仅用于 SR25；本项目调整尺寸、材质与装配。以上五份原作与衍生 HUD 线稿均为 CC-BY 4.0。

EOTech HWS EXPS 3 — Sambit_Raut
https://sketchfab.com/models/04d1452515134866b8a97c3e7cb9a18e

Foregrip — elitej1gaming
https://sketchfab.com/models/52781078a99c4e55934dab26a998875f

AN/PEQ-15 — D_U
https://sketchfab.com/models/522f6a04c34946dbb168022187645c1a

SureFire M600DF — mbvisuals1
https://sketchfab.com/models/c04c7a9b2f8346bd90c3938b0af8024a

G17 Gen5 + Olight — 8sianDude
https://sketchfab.com/models/0200c248eba14385ad2bee8d4dc4e586

Weapon lights — X400 pistol light+laser — shirioko
https://sketchfab.com/3d-models/weapon-lights-d8315946217a40b38808353a7ce81520
CC-BY 4.0；本项目仅提取并改作 X400 红激光＋白光组合配件。

G17 Pistol - Animated — user77
https://sketchfab.com/models/7723ab14e70446ef8e06a134984f287f

手臂与动作原作 animated pistol — DJMaesen
https://sketchfab.com/models/bd896167e7ca44f19597d3afe6a8d83f

上游 G17 9mm pistol — 3dvachevsky
https://sketchfab.com/models/b4136758508c486cadcd96c74d7882b8

Glock 17 9mm 开火实录 glock17_02.wav — gezortenplotz
https://freesound.org/people/gezortenplotz/sounds/34982/
CC-BY 3.0: https://creativecommons.org/licenses/by/3.0/
本项目由官方 HQ 预览剪取单发、低切、淡变并调整响度；源为 Glock 17，不是 Gen5 专属录音。

SIG MPX 开火近似：MP5A3 9mm 真枪空包弹街道实录 — Franki-01234
https://freesound.org/people/Franki-01234/sounds/201671/
CC0: https://creativecommons.org/publicdomain/zero/1.0/
本项目由官方 HQ 预览剪取连发最后一发及尾响并处理；这是 MP5A3 近似，不是 MPX 或实弹原录。

SIG516 开火近似：Colt M4A1 SOCOM 5.56×45mm 户外真枪录音 — areniporgen
https://freesound.org/people/areniporgen/sounds/737569/
CC0: https://creativecommons.org/publicdomain/zero/1.0/
本项目由官方 HQ 预览剪取0.40秒单发并低切、淡变、调整响度；保留源音高，是同口径近似。

SR25 开火近似：Heckler & Koch G3 7.62×51mm 户外真枪录音 — areniporgen
https://freesound.org/people/areniporgen/sounds/712577/
CC0: https://creativecommons.org/publicdomain/zero/1.0/
本项目由官方 HQ 预览剪取第一发半自动射击及尾声，0.54秒；低切、淡变、调整响度，保留源音高。

Remington M700 .308 开火录音：308_rifle_02.wav — gezortenplotz
https://freesound.org/people/gezortenplotz/sounds/43756/
CC-BY 3.0: https://creativecommons.org/licenses/by/3.0/
作者标明为 Remington 700 户外录音；本项目由官方 HQ 预览剪取0.75秒单发及回响，低切、淡变、调整响度。"
selection_enabled = true

[node name="CloseButton" type="Button" parent="CreditsPanel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "关闭 / Esc"
